@model StudentManagementSystem.Models.Student

@{
    ViewData["Title"] = "Delete Student";
}

<div class="container py-5">
    <div class="card shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Delete Student</h3>
        </div>

        <div class="card-body p-4">
            <p>Are you sure you want to delete this student?</p>

            <dl class="row">
                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Enrollment No.</dt>
                <dd class="col-sm-8">@Model.EnrollmentNo</dd>

                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@Model.Email</dd>

                <dt class="col-sm-4">Department</dt>
                <dd class="col-sm-8">@Model.Department</dd>

                <dt class="col-sm-4">Semester</dt>
                <dd class="col-sm-8">@Model.Semester</dd>
            </dl>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger">
                    Yes, Delete
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>
